<?xml version="1.0" encoding="utf-8"?>
<component>
  <name>org.freedesktop.IBus.SilentCompose</name>
  <description>Silent Windows-style US International composition</description>
  <exec>@libexecdir@/silent-compose-ibus</exec>
  <version>@version@</version>
  <author>SilentCompose contributors &lt;silent-compose@localhost&gt;</author>
  <license>MIT</license>
  <homepage>https://shogun.ms</homepage>
  <textdomain>silent-compose</textdomain>
  <engines>
    <engine>
      <name>silent-compose</name>
      <language>en</language>
      <license>MIT</license>
      <author>SilentCompose contributors &lt;silent-compose@localhost&gt;</author>
      <icon>ibus-keyboard</icon>
      <layout>us</layout>
      <layout_variant>intl</layout_variant>
      <layout_option>lv3:ralt_switch</layout_option>
      <longname>US, intl. Silent Compose</longname>
      <description>US keyboard with silent international composition</description>
      <rank>80</rank>
      <symbol>SC</symbol>
      <setup></setup>
    </engine>
  </engines>
</component>
